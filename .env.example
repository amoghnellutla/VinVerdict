# Copy this file to .env.local (for the website) and .env (for tools/ scripts),
# then fill in the values. Never commit the real files - .gitignore blocks them.
# See docs/SETUP.md for where each value comes from.

# Supabase (Phase 2b) - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_, never use in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Listing APIs (Phase 1) - server-only
MARKETCHECK_API_KEY=
AUTODEV_API_KEY=

# Public demo (docs/SETUP.md step 11)
# Cloudflare Turnstile "I'm human" check: the site key is public by design; the secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt for the one-way hash of visitor IPs (64 random hex characters), server-only.
GUEST_HASH_SALT=
